# Web client (public values; safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: NEVER expose these with NEXT_PUBLIC_ or bundle them in mobile apps.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional hosted processor service integration (server-side only)
PROCESSOR_API_URL=https://YOUR_PROCESSOR_API_URL
PROCESSOR_API_TOKEN=replace-with-a-long-random-secret
