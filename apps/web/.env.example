NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional. Use only a lyrics provider whose contract explicitly permits display
# of its licensed lyrics in this application. Never expose this key to clients.
LICENSED_LYRICS_API_URL=https://YOUR_LICENSED_LYRICS_PROVIDER.example/api/lyrics
LICENSED_LYRICS_API_KEY=replace-with-provider-key

# Optional when the native app uses a custom WebView origin.
MOBILE_APP_ORIGIN=https://localhost
